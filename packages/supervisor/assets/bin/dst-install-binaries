#!/bin/bash
# /usr/local/bin/dst-install-binaries
# The shell half of docs/game-server.md §4 steps 1/2/4 — invoked by src/tasks/install.ts, which
# owns step 3 (the build-id compare, needing the S3 SDK) and step 5 (the background repack, a
# separate script: dst-pack-binaries). Requires DST_BUCKET / DST_REGION in the environment;
# DST_ROOT defaults to /opt/dst.
#
# Warm path streams straight into tar, never to disk (spike §10), and never runs `validate`
# (7.8-13.7 s vs 222 s, spike §5). Cold path (object missing entirely) does the full steamcmd
# install with `validate`.
set -euo pipefail
: "${DST_BUCKET:?DST_BUCKET is required}"
: "${DST_REGION:?DST_REGION is required}"
DST_ROOT="${DST_ROOT:-/opt/dst}"

as_dst() {
    runuser -u dst -- bash -c "$1"
}

# `steamcmd` is not reliable on its first attempt: measured on the first real boot
# (docs/_first-boot-notes.md round 1), a freshly downloaded steamcmd self-updates
# ("Restarting steamcmd by request..."), and the `app_update` that follows in that same
# invocation then fails with exit 8 and `Failed installing AppID 343050 (Missing configuration)`
# in Steam/logs/content_log.txt — the app info is not yet loaded after the re-exec. The next
# invocation succeeds. So: let a fresh steamcmd bootstrap itself in an invocation of its own, and
# retry the `app_update` a few times before giving up (a failure here is fatal to the session).
steam_app_update() {
    local validate_arg="$1"
    local attempt rc
    for attempt in 1 2 3; do
        rc=0
        as_dst "cd '$DST_ROOT/steamcmd' && HOME='$DST_ROOT' ./steamcmd.sh +force_install_dir '$DST_ROOT/server' +login anonymous +app_info_update 1 +app_update 343050 ${validate_arg} +quit" || rc=$?
        if [ "$rc" -eq 0 ]; then
            return 0
        fi
        echo "dst-install-binaries: steamcmd app_update attempt ${attempt} failed (exit ${rc})" >&2
        sleep 10
    done
    echo "dst-install-binaries: steamcmd app_update failed after 3 attempts" >&2
    return 1
}

installed_buildid() {
    sed -nE 's/.*"buildid"[[:space:]]+"([0-9]+)".*/\1/p' \
        "$DST_ROOT/server/steamapps/appmanifest_343050.acf" 2>/dev/null | head -1
}

# The public branch's build id, straight from Steam; empty when it cannot be read.
public_buildid() {
    as_dst "cd '$DST_ROOT/steamcmd' && HOME='$DST_ROOT' ./steamcmd.sh +login anonymous +app_info_update 1 +app_info_print 343050 +quit" 2>/dev/null \
        | awk '/"branches"/{b=1} b&&/"public"/{p=1} p&&/"buildid"/{gsub(/"/,"",$2); print $2; exit}'
}

# False only when Steam's public build is known and differs from the installed one: an unreadable
# public build id must never be what fails a boot.
installed_is_current() {
    local want have
    want=$(public_buildid || true)
    have=$(installed_buildid)
    echo "dst-install-binaries: installed build ${have:-?}, public build ${want:-?}" >&2
    [ -z "$want" ] || [ "$want" = "$have" ]
}

if aws s3api head-object --bucket "$DST_BUCKET" --key binaries/dst-binaries.tar.zst \
    --region "$DST_REGION" >/dev/null 2>&1; then
    # Warm (docs/game-server.md §4 step 1-2).
    aws s3 cp "s3://$DST_BUCKET/binaries/dst-binaries.tar.zst" - --region "$DST_REGION" --no-progress \
      | tar -I zstd -x -C "$DST_ROOT"
    chown -R dst:dst "$DST_ROOT/server" "$DST_ROOT/steamcmd"
    # Two ways the incremental update leaves the old build in place after a Klei patch (both
    # measured 2026-10-03, docs/game-server.md §4): it asks Steam for the manifest of the build
    # *installed* (the tarball's appmanifest) to diff against, and Steam refuses an old manifest to
    # an anonymous login (`'Access Denied'`, exit 8, on every retry); or it logs in, decides there
    # is nothing to do and exits 0 in ~2 s. So success is judged by the build id, not the exit
    # code. Forgetting the install makes steamcmd treat the tree as a fresh install: it fetches only
    # the current manifest, and `validate` reuses every chunk already on disk.
    if ! steam_app_update "" || ! installed_is_current; then
        echo "dst-install-binaries: incremental update did not reach the public build; retrying as a validated fresh install" >&2
        rm -f "$DST_ROOT/server/steamapps/appmanifest_343050.acf"
        steam_app_update "validate"
        installed_is_current || echo "dst-install-binaries: still not on the public build after a validated install (continuing)" >&2
    fi
else
    # Cold (docs/game-server.md §4 step 4): object missing entirely.
    mkdir -p "$DST_ROOT/steamcmd"
    chown dst:dst "$DST_ROOT/steamcmd"
    as_dst "cd '$DST_ROOT/steamcmd' && curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar zxf -"
    # Bootstrap run: let the fresh steamcmd self-update and settle on its own (~10 s) before any
    # app_update is asked of it. Never fatal: the retried app_update below is what must succeed.
    as_dst "cd '$DST_ROOT/steamcmd' && HOME='$DST_ROOT' ./steamcmd.sh +quit" || \
      echo "dst-install-binaries: steamcmd bootstrap run exited non-zero (ignored)" >&2
    steam_app_update "validate"
fi
