{
  "name": "@dst/infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "if [ -d bin ]; then pnpm exec cdk synth; else echo \"@dst/infra: bin/ not present yet, skipping cdk synth\"; fi"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@dst/shared": "workspace:*",
    "aws-cdk": "2.1142.0"
  }
}
